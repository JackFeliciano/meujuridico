[Unit]
Description=MeuJuridico demo
After=network.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/srv/meujuridico
Environment=MEUJURIDICO_BASE=/meujuridico/
ExecStart=/usr/bin/php -S 127.0.0.1:8114 -t showroom showroom/index.php
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/meujuridico
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
